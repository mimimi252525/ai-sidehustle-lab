---
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import Base from '../../layouts/Base.astro';
import { publishedGuides as guides } from '../../data/published-guides';
export function getStaticPaths() {
  return guides.map(guide => ({ params: { id: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
let renderedMarkdown;
if (guide.format === 'markdown') {
  const processor = await createMarkdownProcessor({
    gfm: true,
    smartypants: false,
    syntaxHighlight: false,
    remarkRehype: { allowDangerousHtml: false },
  });
  const markdown = [
    guide.intro,
    ...guide.sections.map(({ heading, body }) => `## ${heading}\n\n${body}`),
  ].join('\n\n');
  renderedMarkdown = (await processor.render(markdown)).code;
}
---
<Base title={guide.title} description={guide.description}>
  <article class="wrap page narrow">
    <a class="back" href="/guides/">← AI副業ガイド</a>
    <header class="page-heading"><div class="tags"><span>{guide.category}</span></div><h1>{guide.title}</h1><p>{guide.description}</p><time datetime={guide.updated}>更新日 {guide.updated.replaceAll('-', '.')}</time></header>
    <div class="card reading">{renderedMarkdown !== undefined ? <Fragment set:html={renderedMarkdown} /> : guide.sections.map(({ heading, body }) => <section><h2>{heading}</h2><p>{body}</p></section>)}</div>
    <div class="actions"><a class="button secondary" href="/tools/">AIツールを比較する</a><a class="button primary" href="/prompts/">プロンプトを作る</a></div>
  </article>
</Base>
